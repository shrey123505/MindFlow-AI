# Required: Server-side Gemini API key (automatically provided in Google AI Studio)
GEMINI_API_KEY=

# Optional: Additional comma-separated or numbered API keys for automatic failover & rotation on 429 quota limits
# GEMINI_API_KEYS=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional server tuning (leave unset in Google AI Studio — safe defaults apply automatically):
# PORT=3000
# TRUST_PROXY_HOPS=1
# ALLOWED_ORIGINS=https://your-custom-domain.example.com
# AI_HOURLY_IP_LIMIT=120
# MINDFLOW_API_ACCESS_TOKEN=

# Free fair-use limits on the shared key (per visitor IP / whole site, UTC reset).
# Visitors who paste their own Gemini key are never counted.
# MINDFLOW_DAILY_ANALYSIS_LIMIT=5
# MINDFLOW_DAILY_AI_ACTION_LIMIT=40
# MINDFLOW_AI_DAILY_GLOBAL_LIMIT=150
