# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Optional HTTP port for the Express server (defaults to 3000).
PORT="3000"

# TRUST_PROXY_HOPS: Optional reverse-proxy hop count (1-4, or "false" for local direct connections).
# Automatically defaults to 1 on Cloud Run / production deployments and false in local dev.
# TRUST_PROXY_HOPS="1"
