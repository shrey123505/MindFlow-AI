# Required: Server-side Gemini API key (automatically provided in Google AI Studio)
GEMINI_API_KEY=

# Optional server tuning (leave unset in Google AI Studio — safe defaults apply automatically):
# PORT=3000
# TRUST_PROXY_HOPS=1
# ALLOWED_ORIGINS=https://your-custom-domain.example.com
# AI_HOURLY_IP_LIMIT=120
# MINDFLOW_API_ACCESS_TOKEN=

# Account storage must point to persistent private storage in production.
# The default is ./data/auth-store.json (single-server deployments only).
# MINDFLOW_AUTH_STORE_PATH=./data/auth-store.json

# Per-account and site-wide daily limits for uncached AI work (UTC reset).
# Cache hits do not consume these limits.
# MINDFLOW_DAILY_ANALYSIS_LIMIT=3
# MINDFLOW_DAILY_AI_ACTION_LIMIT=20
# MINDFLOW_AI_DAILY_GLOBAL_LIMIT=50
